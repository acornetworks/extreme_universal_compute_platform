apiVersion: v1
kind: Namespace
metadata:
  name: extreme

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dnsmasq-conf
  namespace: extreme
data:
  dnsmasq.conf: |
    
    port=0
    log-dhcp
    interface=eth1
    bind-interfaces
    dhcp-authoritative    
    
    dhcp-range=set:net01,10.120.7.10,10.120.7.99,255.255.255.0,24h
    dhcp-option=set:net01,3,10.120.7.1
    # DNS servers for clients
    dhcp-option=set:net01,6,10.120.7.251
    # Domain name
    dhcp-option=set:net01,15,corp.local
    # NTP servers
    dhcp-option=set:net01,42,10.120.7.251
    # Local DNS domain
    domain=corp.local
    expand-hosts

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: extreme-dhcp
  namespace: extreme
spec:
  replicas: 1
  selector:
    matchLabels:
      app: extreme-dhcp
  template:
    metadata:
      labels:
        app: extreme-dhcp
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      tolerations:
        - key: "node-role.kubernetes.io/control-plane"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node-role.kubernetes.io/master"
          operator: "Exists"
          effect: "NoSchedule"
      containers:
        - name: dnsmasq
          image: zorbatherainy/misc_images:dnsmasq-latest
          securityContext:
            capabilities:
              add:
                - NET_ADMIN
                - NET_RAW
          volumeMounts:
            - name: config
              mountPath: /etc/dnsmasq.conf
              subPath: dnsmasq.conf
      volumes:
        - name: config
          configMap:
            name: dnsmasq-conf          

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bind9-config
  namespace: extreme
data:
  named.conf: |
    include "/etc/bind/named.conf.options";
    include "/etc/bind/named.conf.local";

  named.conf.options: |
    options {
      directory "/var/cache/bind";

      recursion yes;
      allow-recursion { any; };
      allow-query { any; };

      dnssec-validation no;

      forwarders { 8.8.4.4; 8.8.8.8; };
      forward only;

      listen-on port 53 { 10.120.6.210; };
      listen-on-v6 { none; };
    };

  named.conf.local: |
    zone "corp.local" {
      type master;
      file "/etc/bind/zones/db.corp.local";
      allow-update { none; };
    };

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bind9-zones
  namespace: extreme
data:
  db.corp.local: |
    $TTL 300
    @   IN  SOA ns1.corp.local. admin.corp.local. (
            2026031101 ; serial
            3600
            900
            604800
            300 )
        IN  NS  ns1.corp.local.
    @               IN  A   10.120.6.210
    ns1             IN  A   10.120.6.210
    extremecontrol  IN  A   10.120.6.200

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: extreme-dns
  namespace: extreme
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: bind9
  template:
    metadata:
      labels:
        app: bind9
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      containers:
      - name: bind9
        image: internetsystemsconsortium/bind9:9.18
        ports:
        - name: dns-udp
          containerPort: 53
          protocol: UDP
        - name: dns-tcp
          containerPort: 53
          protocol: TCP
        volumeMounts:
        - name: bind-config
          mountPath: /etc/bind/named.conf
          subPath: named.conf
        - name: bind-config
          mountPath: /etc/bind/named.conf.options
          subPath: named.conf.options
        - name: bind-config
          mountPath: /etc/bind/named.conf.local
          subPath: named.conf.local
        - name: zones
          mountPath: /etc/bind/zones/db.corp.local
          subPath: db.corp.local
      volumes:
      - name: bind-config
        configMap:
          name: bind9-config
      - name: zones
        configMap:
          name: bind9-zones
